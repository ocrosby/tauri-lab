{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Baseline + fs (scoped to app data) + dialog",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    {
      "identifier": "fs:scope-appdata-recursive",
      "allow": [{ "path": "$APPDATA/**" }]
    }
  ]
}
