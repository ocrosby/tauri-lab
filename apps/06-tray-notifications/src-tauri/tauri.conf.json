{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tray-notifications",
  "version": "0.1.0",
  "identifier": "com.tauri-lab.tray-notifications",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tray & notifications",
        "width": 640,
        "height": 400
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
